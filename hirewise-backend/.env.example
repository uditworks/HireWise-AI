# ==========================================
# HireWise Backend Environment Configuration Example
# Copy this file to .env and replace placeholder values with your actual configuration.
# NEVER commit the real .env file with production secrets to version control.
# ==========================================

# Server Port (Render sets this dynamically, defaults to 8080 locally)
PORT=8080

# Database Configuration (MySQL / Aiven Cloud MySQL)
# For local development: jdbc:mysql://localhost:3306/hirewise_ai?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# For Aiven Cloud MySQL: jdbc:mysql://<aiven-host>:<aiven-port>/defaultdb?sslMode=REQUIRED
DB_URL=jdbc:mysql://localhost:3306/hirewise_ai?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# CORS Allowed Origins (Comma-separated frontend URLs)
# Example for production: http://localhost:5173,https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# JPA / Hibernate Schema Management (update preserves existing data)
HIBERNATE_DDL_AUTO=update

# JWT Configuration (Secret must be >= 32 characters for HS256)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_here
JWT_EXPIRATION_MS=86400000

# File Storage Configuration (Render free tier disk is ephemeral)
RESUME_STORAGE_DIR=./storage/resumes

# AI Resume Analyzer Configuration (local | gemini)
AI_PROVIDER=local
AI_API_KEY=your_gemini_api_key_if_using_gemini
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=8000
