# ==========================================
# HireWise Frontend Environment Configuration Example
# Copy this file to .env and configure appropriate values for your deployment.
# Note: Any variable prefixed with VITE_ is bundled into client JavaScript and exposed to the browser.
# NEVER store secrets, private API keys, or passwords in frontend environment variables.
# ==========================================

# API Base URL (defaults to /api which is proxied to http://localhost:8080 in dev)
VITE_API_BASE_URL=/api
